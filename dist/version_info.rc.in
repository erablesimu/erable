#include "winresrc.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @ERABLE_VERSION_NUMBER@,0,0,0
PRODUCTVERSION @ERABLE_VERSION_NUMBER@,0,0,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Erable"
            VALUE "FileDescription", "@ERABLE_FILE_DESCRIPTION@"
            VALUE "FileVersion", "@ERABLE_VERSION_STRING@"
            VALUE "InternalName", "@ERABLE_FILE_NAME@"
            VALUE "LegalCopyright", "Copyright Erable and the Lichii, Eden and yuzu projects, GPL-3.0-or-later"
            VALUE "OriginalFilename", "@ERABLE_FILE_NAME@"
            VALUE "ProductName", "Erable"
            VALUE "ProductVersion", "@ERABLE_VERSION_STRING@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
